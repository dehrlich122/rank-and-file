{
  "name": "rank-and-file",
  "private": true,
  "version": "0.0.0",
  "description": "A browser puzzle game that teaches Python by writing real code to move a chess piece.",
  "type": "module",
  "scripts": {
    "postinstall": "node scripts/copy-pyodide.mjs",
    "dev": "vite",
    "build": "vite build",
    "play": "vite build && vite preview --open",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:py": "node scripts/pytest.mjs",
    "check": "npm run typecheck && npm run test && npm run test:py"
  },
  "dependencies": {
    "@codemirror/commands": "^6.11.1",
    "@codemirror/lang-python": "^6.2.1",
    "@codemirror/language": "^6.12.4",
    "@codemirror/lint": "^6.9.7",
    "@codemirror/state": "^6.7.6",
    "@codemirror/view": "^6.43.13",
    "codemirror": "^6.0.2",
    "marked": "^18.0.14",
    "pyodide": "^314.0.7",
    "yaml": "^2.9.1"
  },
  "devDependencies": {
    "typescript": "^7.0.2",
    "vite": "^8.3.1",
    "vitest": "^5.0.2"
  }
}
