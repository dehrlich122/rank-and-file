{
  "name": "rank-and-file",
  "private": true,
  "version": "0.0.0",
  "description": "A browser puzzle game that teaches Python by writing real code to move a chess piece.",
  "license": "MIT AND CC-BY-NC-SA-4.0",
  "type": "module",
  "scripts": {
    "postinstall": "node scripts/copy-pyodide.mjs",
    "dev": "vite",
    "build": "vite build",
    "play": "vite build && vite preview --open",
    "typecheck": "tsc --noEmit",
    "lint": "npm run lint:ts && npm run lint:py && npm run lint:dupes",
    "lint:ts": "knip",
    "lint:py": "node scripts/venv.mjs ruff check && node scripts/venv.mjs vulture",
    "lint:dupes": "jscpd",
    "test": "vitest run",
    "test:py": "node scripts/venv.mjs pytest",
    "check:bundle": "node scripts/check-bundle.mjs",
    "demo": "node scripts/package-demo.mjs",
    "e2e": "node scripts/e2e/run.mjs",
    "check": "npm run typecheck && npm run lint && npm run test && npm run test:py && npm run check:bundle"
  },
  "dependencies": {
    "@codemirror/autocomplete": "^6.20.3",
    "@codemirror/commands": "^6.11.1",
    "@codemirror/lang-python": "^6.2.1",
    "@codemirror/language": "^6.12.4",
    "@codemirror/lint": "^6.9.7",
    "@codemirror/search": "^6.7.2",
    "@codemirror/state": "^6.7.6",
    "@codemirror/view": "^6.43.13",
    "@lezer/highlight": "^1.2.4",
    "marked": "^18.0.14",
    "pyodide": "^314.0.7",
    "yaml": "^2.9.1"
  },
  "devDependencies": {
    "@fontsource/orbitron": "^5.3.0",
    "@fontsource/press-start-2p": "^5.3.0",
    "@fontsource/silkscreen": "^5.3.0",
    "@fontsource/vt323": "^5.3.0",
    "jscpd": "^5.3.2",
    "knip": "^6.38.0",
    "typescript": "^7.0.2",
    "vite": "^8.3.1",
    "vitest": "^5.0.2"
  }
}
